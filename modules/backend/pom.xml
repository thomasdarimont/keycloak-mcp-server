<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.thomasdarimont.keycloak</groupId>
        <artifactId>keycloak-mcp-server</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>keycloak-mcp-server-backend</artifactId>
    <packaging>quarkus</packaging>
    <name>Keycloak MCP Server Backend</name>

    <properties>
        <maven.build.timestamp.format>yyyy-MM-dd'T'HH:mm'Z'</maven.build.timestamp.format>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>
        <!-- what quarkus:dev passes to the command line; not start-dev, which would override the profile of a run -->
        <quarkus.args>start</quarkus.args>
        <!-- emptied by the dist profile below -->
        <web-bundler.web-root.setting>quarkus.web-bundler.web-root=frontend</web-bundler.web-root.setting>
    </properties>

    <dependencies>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.thomasdarimont.keycloak</groupId>
            <artifactId>keycloak-mcp-server-api</artifactId>
        </dependency>
        <dependency>
            <!-- optional database storage (systems, keys, secrets, audit); dormant without a configured datasource.
                 Drop it to build a server without JDBC drivers. -->
            <groupId>com.github.thomasdarimont.keycloak</groupId>
            <artifactId>keycloak-mcp-server-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mvnpm</groupId>
            <artifactId>lit</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mvnpm.at.lit</groupId>
            <artifactId>context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mvnpm.at.lit-labs</groupId>
            <artifactId>router</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.mvnpm</groupId>
            <artifactId>urlpattern-polyfill</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.mcp</groupId>
            <artifactId>quarkus-mcp-server-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-keycloak-admin-rest-client</artifactId>
        </dependency>
        <dependency>
            <!-- the admin API is a JAX-RS resource (Quarkus REST) exchanging plain maps as JSON, secured by Quarkus Security -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <!-- the header of a prompt file (backend.prompts.PromptFile) -->
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <dependency>
            <!-- serves the admin API's OpenAPI document (META-INF/openapi.yaml) at /q/openapi -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <!-- metrics (and traces) over OTLP; the SDK is off until QUARKUS_OTEL_SDK_DISABLED=false -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- InMemoryMetricReader for the metrics tests; version from the OpenTelemetry BOM Quarkus imports -->
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- @AutoService generates the META-INF/services entries of the SPI implementations -->
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>application.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>application.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <!-- only @prop@ is filtered, so Quarkus ${...} expressions in application.properties stay intact -->
                    <propertiesEncoding>UTF-8</propertiesEncoding>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                    <delimiters>
                        <delimiter>@</delimiter>
                    </delimiters>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Lit management UI under src/main/resources/frontend, bundled by Quarkus Web Bundler (no Node/npm), with
                 hot reload in quarkus:dev. Maven switches this off when the dist profile below is active. -->
            <id>web-bundler</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>io.quarkiverse.web-bundler</groupId>
                    <artifactId>quarkus-web-bundler</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <!-- Web Bundler cannot run when `bin/kcmcp.sh build` re-augments an unpacked distribution, so the distribution
                 has the bundle as a static jar instead of the extension. -->
            <id>dist</id>
            <properties>
                <web-bundler.web-root.setting></web-bundler.web-root.setting>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>com.github.thomasdarimont.keycloak</groupId>
                    <artifactId>keycloak-mcp-server-ui-bundle</artifactId>
                    <version>${project.version}</version>
                    <!-- static files only: the extension that made them must not come along -->
                    <exclusions>
                        <exclusion>
                            <groupId>*</groupId>
                            <artifactId>*</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
