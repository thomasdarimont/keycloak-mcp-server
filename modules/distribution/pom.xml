<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.thomasdarimont.keycloak</groupId>
        <artifactId>keycloak-mcp-server</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>keycloak-mcp-server-distribution</artifactId>
    <packaging>pom</packaging>
    <name>keycloak-mcp-server-distribution</name>
    <description>The downloadable distribution: bin/kcmcp.sh and kcmcp.bat, conf/, the packaged server under lib/, providers/, data/, docs/</description>

    <properties>
        <!-- the fast-jar layout the backend's package phase produces -->
        <backend.quarkus-app>${project.basedir}/../backend/target/quarkus-app</backend.quarkus-app>
    </properties>

    <dependencies>
        <!-- build order only: the backend's quarkus-app directory is what gets packaged -->
        <dependency>
            <groupId>com.github.thomasdarimont.keycloak</groupId>
            <artifactId>keycloak-mcp-server-backend</artifactId>
            <version>${project.version}</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>keycloak-mcp-server-${project.version}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <executions>
                    <execution>
                        <id>dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/dist.xml</descriptor>
                            </descriptors>
                            <appendAssemblyId>false</appendAssemblyId>
                            <tarLongFileMode>posix</tarLongFileMode>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
