# Service account: a confidential client inside the realm it administers, with the realm-management roles it needs
# (realm-admin for everything, or only view-users, manage-users, ... for less). Keycloak: Clients -> create a client,
# turn on "Client authentication" and "Service accounts roles", assign the roles under "Service account roles", copy
# the secret from "Credentials". On Keycloak 26.8.2+ also add the client scope kc-admin-api as a default scope.
#   cp conf/scenarios/service-account.conf.example conf/service-account.conf   # then edit, and
#   bin/kcmcp.sh start --config conf/service-account.conf
kc-mcp.systems.default.url=http://localhost:8080
kc-mcp.systems.default.auth-realm=demo
kc-mcp.systems.default.grant-type=client_credentials
kc-mcp.systems.default.client-id=mcp-admin
kc-mcp.systems.default.client-secret=change-me
kc-mcp.systems.default.default-realm=demo
kc-mcp.systems.default.allowed-realms=demo
kc-mcp.tools.exposure=hybrid
