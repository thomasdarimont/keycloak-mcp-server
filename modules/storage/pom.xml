<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.thomasdarimont.keycloak</groupId>
        <artifactId>keycloak-mcp-server</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>keycloak-mcp-server-storage</artifactId>
    <name>Keycloak MCP Server Storage</name>
    <description>Optional database storage for the Keycloak MCP server: Keycloak systems, private_key_jwt key material,
        secrets and audit events in an embedded H2 database or PostgreSQL (Hibernate ORM with Panache, schema managed by
        Liquibase). Dormant unless a JDBC datasource is configured.</description>

    <properties>
        <!-- surefire's @{argLine} is set by the Quarkus plugin in the backend; a plain jar module defines it empty -->
        <argLine/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.github.thomasdarimont.keycloak</groupId>
            <artifactId>keycloak-mcp-server-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <!-- embedded default (quarkus.datasource.db-kind=h2); the kind is fixed when the application is built -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-h2</artifactId>
        </dependency>
        <dependency>
            <!-- production: build the application with -Ppostgresql (root pom profile) -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-postgresql</artifactId>
        </dependency>
        <!-- The other databases a distribution can be built for (bin/kcmcp.sh build with db=mariadb, mysql or mssql; from source the Maven profile of that name), as Keycloak ships them: the integration and the
             driver on the class path, dormant until the kind is chosen. Available, and supported once the storage
             tests pass on them (docs/storage.md). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-mariadb</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jdbc-mssql</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-liquibase</artifactId>
        </dependency>
        <dependency>
            <!-- the hourly purge of audit events older than kc-mcp.spi.audit-listener.db.retention-days -->
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-scheduler</artifactId>
        </dependency>
        <dependency>
            <!-- Argon2id for deriving the encryption key from a passphrase (the JDK has no Argon2) -->
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>
        <dependency>
            <!-- @AutoService generates the META-INF/services entry of the config source factory -->
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- a Jandex index lets the application discover the entities, the config mapping and the beans -->
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- the database test runs against Dev Services (PostgreSQL, or -Dit.db-kind and -Dit.db-image); run with
                     -DskipITs=false -->
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- The distribution also carries the Oracle integration, without Oracle's driver, which is not ours to
                 ship: an administrator puts ojdbc17 (and orai18n) into lib/providers and builds for oracle, as with
                 Keycloak. The integration fails when a datasource closes without the driver, so it must not be loaded
                 unless the server is built for oracle: the backend's package is rebuilt without it after packaging
                 (modules/backend), bin/kcmcp.sh build leaves out every database but the chosen one, and builds
                 without this profile do not have it at all. -->
            <id>dist</id>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jdbc-oracle</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>com.oracle.database.jdbc</groupId>
                            <artifactId>ojdbc17</artifactId>
                        </exclusion>
                        <exclusion>
                            <groupId>com.oracle.database.nls</groupId>
                            <artifactId>orai18n</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
