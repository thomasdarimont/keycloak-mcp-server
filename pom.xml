<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.thomasdarimont.keycloak</groupId>
    <artifactId>keycloak-mcp-server</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <!-- what extensions compile against: the SPI, tool catalog types and the admin client facade -->
        <module>modules/api</module>
        <!-- optional database storage: systems, key material and audit events in PostgreSQL -->
        <module>modules/storage</module>
        <!-- the Quarkus application (includes the Lit management UI via Quarkus Web Bundler) -->
        <module>modules/backend</module>
        <!-- test_* tools and prompts for the MCP conformance suite, an extension jar; see conformance/README.md -->
        <module>conformance/fixtures</module>
        <!-- examples/extensions -->
        <module>examples/extensions</module>
    </modules>

    <properties>
        <compiler-plugin.version>3.16.0</compiler-plugin.version>
        <resources-plugin.version>3.5.0</resources-plugin.version>
        <jar-plugin.version>3.5.1</jar-plugin.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.40.1.1</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.6.1</surefire-plugin.version>
        <spotless-maven-plugin.version>3.11.0</spotless-maven-plugin.version>
        <!-- pinned above the Quarkus platform's 2.21.7 for the jackson-databind CVE fix; drop once the platform catches up -->
        <jackson.version>2.21.8</jackson.version>
        <auto-service.version>1.1.1</auto-service.version>
        <jandex-maven-plugin.version>3.6.0</jandex-maven-plugin.version>
        <quarkus-web-bundler.version>3.0.0</quarkus-web-bundler.version>
        <mvnpm.lit.version>3.3.3</mvnpm.lit.version>
        <!-- database kind of the storage module, baked into the backend at build time: h2 or postgresql (-Ppostgresql) -->
        <storage.db-kind>h2</storage.db-kind>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <!-- imported first so its versions win over the platform BOM for every Jackson module -->
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-mcp-server-bom</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.github.thomasdarimont.keycloak</groupId>
                <artifactId>keycloak-mcp-server-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.thomasdarimont.keycloak</groupId>
                <artifactId>keycloak-mcp-server-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.web-bundler</groupId>
                <artifactId>quarkus-web-bundler</artifactId>
                <version>${quarkus-web-bundler.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mvnpm</groupId>
                <artifactId>lit</artifactId>
                <version>${mvnpm.lit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.auto.service</groupId>
                <artifactId>auto-service-annotations</artifactId>
                <version>${auto-service.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

