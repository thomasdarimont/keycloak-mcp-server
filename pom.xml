                            <importOrder>
                                <order>java|javax|jakarta,org,com,,\#</order>
                            </importOrder>
                            <removeUnusedImports/>
                            <eclipse>
                                <!-- the Spring Java Format conventions with spaces, see the file -->
                                <file>${maven.multiModuleProjectDirectory}/etc/eclipse-formatter.prefs</file>
                            </eclipse>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </java>
                    </configuration>
