    <profiles>
        <profile>
            <!-- The downloadable distribution (modules/distribution: bin/kcmcp.sh, conf/, the server under lib/, as
                 tar.gz and zip): `./mvnw package -Pdist`. Not part of the default build, which stays at the jars. -->
            <id>dist</id>
            <modules>
                <module>modules/ui-bundle</module>
                <module>modules/distribution</module>
            </modules>
        </profile>
        <profile>
            <!-- The database kind of the storage module is fixed when the application is built (Quarkus bakes the
                 dialect in): the default build is for the embedded H2, `./mvnw package -Ppostgresql` builds the
                 server for PostgreSQL. Tests keep running on H2 either way. -->
            <id>postgresql</id>
            <properties>
                <storage.db-kind>postgresql</storage.db-kind>
            </properties>
        </profile>
    </profiles>
</project>
