{
  "realm": "acme-dev",
  "displayName": "ACME / development",
  "enabled": true,
  "adminPermissionsEnabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "eventsEnabled": true,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN",
    "CLIENT_LOGIN",
    "CLIENT_LOGIN_ERROR",
    "TOKEN_EXCHANGE",
    "TOKEN_EXCHANGE_ERROR",
    "GRANT_CONSENT",
    "REVOKE_GRANT"
  ],
  "adminEventsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "support",
        "description": "Support desk"
      },
      {
        "name": "developer",
        "description": "Application developers"
      }
    ]
  },
  "groups": [
    {
      "name": "staff",
      "path": "/staff"
    },
    {
      "name": "mcp-admins",
      "path": "/mcp-admins",
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    },
    {
      "name": "mcp-support",
      "path": "/mcp-support",
      "realmRoles": [
        "support"
      ],
      "clientRoles": {
        "realm-management": [
          "view-users",
          "view-events",
          "query-users",
          "query-groups"
        ]
      }
    },
    {
      "name": "mcp-developers",
      "path": "/mcp-developers",
      "realmRoles": [
        "developer"
      ],
      "clientRoles": {
        "realm-management": [
          "view-clients",
          "manage-clients",
          "query-clients",
          "view-realm",
          "view-users",
          "query-users"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "mcp-consumer",
      "optionalClientScopes": ["delegation:client", "offline_access"],
      "defaultClientScopes": ["web-origins", "acr", "basic"],
      "name": "MCP consumer (LLM client)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "consentRequired": true,
      "serviceAccountsEnabled": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:33389/mcp-oauth-callback",
        "http://localhost/callback",
        "http://localhost/oauth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "fullScopeAllowed": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "1800"
      },
      "description": "Public PKCE client MCP clients log the user in with. Consent required: the user is asked every session whether keycloak-mcp-server may act on their behalf. Its tokens carry aud=keycloak-mcp-server and no admin roles.",
      "protocolMappers": [
        {
          "name": "mcp server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "keycloak-mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Liddell",
      "email": "alice@acme.example",
      "groups": [
        "/staff",
        "/mcp-admins"
      ],
      "realmRoles": [
        "default-roles-acme-dev"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "sam",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Spade",
      "email": "sam@acme.example",
      "groups": [
        "/staff",
        "/mcp-support"
      ],
      "realmRoles": [
        "default-roles-acme-dev"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "sam-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "dave",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Developer",
      "email": "dave@acme.example",
      "groups": [
        "/staff",
