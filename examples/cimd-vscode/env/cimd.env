# The MCP endpoint requires an OAuth login. The user consents to the server's client keycloak-mcp acting on their
# behalf (scope delegation:client:keycloak-mcp), and every Admin API call runs with a delegated token Keycloak issues
# for that pair (token exchange delegation, preview): sub = the user, act = keycloak-mcp. The user's own token never
# reaches the Admin API, and the server's client holds no admin role at all.
#   alice  realm-admin (alice-demo)     carol  view-users (carol-demo)     dave  nobody (dave-demo)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
KC_MCP_SYSTEMS_DEFAULT_URL=https://localhost:8100
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=exchange
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=keycloak-mcp
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=keycloak-mcp-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
# the server's client may not read the server info, so the version is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
QUARKUS_HTTP_PORT=8101
QUARKUS_OIDC_TENANT_ENABLED=true
# Only tokens issued for this server: the delegation scope adds aud=keycloak-mcp.
QUARKUS_OIDC_TOKEN_AUDIENCE=keycloak-mcp
# What MCP clients are told to ask for (RFC 9728 scopes_supported): without the delegation scope the user is not
# asked to consent to the delegation and the token does not open this server.
QUARKUS_OIDC_RESOURCE_METADATA_SCOPES=openid,delegation:client:keycloak-mcp
