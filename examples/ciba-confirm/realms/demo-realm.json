{
  "realm": "demo",
  "displayName": "CIBA confirmation demo",
  "enabled": true,
  "adminPermissionsEnabled": true,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "sslRequired": "none",
  "accessTokenLifespan": 1800,
  "attributes": {
    "cibaBackchannelTokenDeliveryMode": "poll",
    "cibaExpiresIn": "120",
    "cibaInterval": "2",
    "cibaAuthRequestedUserHint": "login_hint"
  },
  "users": [
    {
      "username": "alice",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "alice-demo",
          "temporary": false
        }
      ],
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    },
    {
      "username": "carol",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Support",
      "credentials": [
        {
          "type": "password",
          "value": "carol-demo",
          "temporary": false
        }
      ],
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "username": "dave",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "email": "dave@example.com",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Developer",
      "credentials": [
        {
          "type": "password",
          "value": "dave-demo",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "mcp-consumer",
      "optionalClientScopes": ["delegation:client", "offline_access"],
      "name": "MCP consumer (LLM client)",
      "description": "Public PKCE client that MCP clients log the user in with; its tokens open the MCP server only (aud=keycloak-mcp). Consent required: Keycloak asks the user whether keycloak-mcp may act on their behalf.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "consentRequired": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://127.0.0.1:33389/mcp-oauth-callback",
        "http://localhost:9999/*",
        "http://localhost/callback",
        "http://localhost/oauth/callback",
        "http://127.0.0.1/",
        "https://vscode.dev/redirect"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "mcp server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "keycloak-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mcp-ciba",
      "name": "MCP server CIBA client",
      "description": "Confidential client the MCP server files CIBA authentication requests with before a destructive tool runs",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "mcp-ciba-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "oidc.ciba.grant.enabled": "true"
      }
    },
    {
      "clientId": "ciba-approver",
      "name": "Approver (the user's device)",
      "description": "Public PKCE client of the approver app at http://localhost:8095, where users sign in to decide the CIBA requests meant for them. Direct access grants are on for demo.sh only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8095/*"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "keycloak-mcp",
      "name": "keycloak-mcp (the MCP server, actor)",
      "description": "The MCP server's own client: a service account without any admin role, allowed to perform token exchange. Users consent to it acting on their behalf; its role scope (clientScopeMappings) caps what a delegated token may carry, whoever the user is.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "keycloak-mcp-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "standard.token.exchange.enabled": "true"
      },
      "defaultClientScopes": ["acr", "basic", "roles", "profile", "kc-admin-api", "service_account"],
      "optionalClientScopes": []
    },
    {
      "clientId": "keycloak-mcp-ui",
      "name": "MCP server management UI",
      "description": "Public PKCE client the MCP server's management UI signs people in with (authorization code flow, the server is the relying party). Full scope off: the role scope lists what a token may carry.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:8099/bff/login"
      ],
      "webOrigins": [
        "+"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8099/ui/*"
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "keycloak-mcp",
        "roles": ["realm-admin"]
      },
      {
        "client": "keycloak-mcp-ui",
        "roles": ["realm-admin"]
      }
    ]
  }
}
