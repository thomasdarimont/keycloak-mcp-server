# CIBA confirmation: the MCP endpoint requires an OAuth login, and every Admin API call is made with a delegated
# token Keycloak issues for that user and the server's client keycloak-mcp together (token exchange delegation,
# preview in Keycloak 26.8): sub = the user, act = keycloak-mcp. The user consents to that at login; their own token
# never reaches the Admin API. Every destructive tool waits for the caller's approval on their device: the server
# files a CIBA authentication request as the client mcp-ciba for the signed-in user, Keycloak delivers it to the
# approver (http://localhost:8095/), the tool runs once the user approves there. confirm: true counts for nothing
# (confirm-fallback=deny), elicitation is not used either (when=always).
#   alice  realm-admin  (alice-demo)     carol  view-users (carol-demo)     dave  nobody (dave-demo)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
# What Keycloak needs for the delegation (consent on mcp-consumer, the client keycloak-mcp, the delegate permission):
# ../delegated-auth/README.md.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8098
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_MCP_DELEGATION=exchange
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=keycloak-mcp
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=keycloak-mcp-secret
# the server's client may not read the server info, so the version is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOLS_EXPOSURE=hybrid
KC_MCP_CONFIRM_FALLBACK=deny
QUARKUS_HTTP_PORT=8099
KC_MCP_MCP_OAUTH_ENABLED=true
# Only tokens issued for the MCP server: the audience mapper on mcp-consumer adds aud=keycloak-mcp.
KC_MCP_MCP_OAUTH_AUDIENCE=keycloak-mcp
# What the protected resource metadata tells MCP clients to ask for: without the delegation scope the user is not
# asked to consent and every tool answers delegation_failed.
KC_MCP_MCP_OAUTH_RESOURCE_METADATA_SCOPES=openid,delegation:client:keycloak-mcp
# the CIBA client (kc-mcp.spi.confirmer.ciba.*); issuer defaults to the caller's token issuer, the demo realm
KC_MCP_SPI_CONFIRMER_CIBA_ENABLED=true
KC_MCP_SPI_CONFIRMER_CIBA_CLIENT_ID=mcp-ciba
KC_MCP_SPI_CONFIRMER_CIBA_CLIENT_SECRET=mcp-ciba-secret
KC_MCP_SPI_CONFIRMER_CIBA_TIMEOUT_SECONDS=90
# the second call waits this long for the device, so the model can call again right away and notice the decision
# without the user writing "done" in the chat; a pending answer after that means one more call
KC_MCP_SPI_CONFIRMER_CIBA_POLL_WAIT_SECONDS=25
# KC_MCP_SPI_CONFIRMER_CIBA_FLOW=blocking               # wait in the call instead of answering twice (no number matching)
# KC_MCP_SPI_CONFIRMER_CIBA_WHEN=without-elicitation   # let clients with elicitation ask the human themselves
# KC_MCP_SPI_CONFIRMER_CIBA_LOGIN_HINT=email           # how the provider identifies the user (default: username)
# KC_MCP_SPI_CONFIRMER_CIBA_CLIENT_AUTH=client_secret_post   # for providers without HTTP Basic client auth
# The management UI, to look around while the demo runs: http://localhost:8099/ui/ (alice / alice-demo), with the
# systems, the realm and the audit trail of the tool calls. It needs the database storage, here an H2 file under
# data/ (git-ignored), and HTTPS, which dev mode lifts (its session cookie drops Secure; for one person's machine
# only). Dynamic systems stay off, so the one system here remains the default. docs/management-ui.md
KC_MCP_UI_ENABLED=true
KC_MCP_DEV_MODE=true
KC_MCP_UI_OPERATOR_ROLE=realm-management.realm-admin
KC_MCP_DYNAMIC_SYSTEMS=false
QUARKUS_DATASOURCE_JDBC_URL=jdbc:h2:file:./data/kc-mcp-ciba
KC_MCP_STORAGE_SECRET_KEY=demo-storage-key-change-me
