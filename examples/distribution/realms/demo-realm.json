{
  "realm": "demo",
  "displayName": "Demo",
  "enabled": true,
  "adminPermissionsEnabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "accessTokenLifespan": 1800,
  "clients": [
    {
      "clientId": "mcp-consumer",
      "name": "MCP consumer (LM Studio, Claude, ...)",
      "description": "Public PKCE client the MCP clients log the user in with; tokens carry aud=keycloak-mcp-server and no admin roles. Consent required: the user is asked whether keycloak-mcp-server may act on their behalf.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "consentRequired": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:33389/mcp-oauth-callback",
        "http://localhost/callback",
        "http://localhost/oauth/callback",
        "http://127.0.0.1/",
        "https://vscode.dev/redirect"
      ],
      "webOrigins": [
        "+"
      ],
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": ["delegation:client", "offline_access"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "1800"
      },
      "protocolMappers": [
        {
          "name": "mcp server audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "keycloak-mcp-server",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "keycloak-mcp-server",
      "name": "Keycloak MCP server",
      "description": "The MCP server's client, the actor of the token exchange: a service account without admin roles, authenticating with a signed JWT (private_key_jwt, key from the server's JWKS). Its role scope caps what a delegated token may carry.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "fullScopeAllowed": false,
      "clientAuthenticatorType": "client-jwt",
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email",
        "kc-admin-api",
        "service_account"
      ],
      "attributes": {
        "standard.token.exchange.enabled": "true",
        "use.jwks.url": "true",
        "jwks.url": "http://host.docker.internal:9080/.well-known/jwks.json",
        "token.endpoint.auth.signing.alg": "RS256"
      }
    }
  ],
  "groups": [
    {
      "name": "mcp-admins",
      "path": "/mcp-admins",
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    },
    {
      "name": "mcp-support",
      "path": "/mcp-support",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    },
    {
      "name": "staff",
      "path": "/staff"
    }
  ],
  "users": [
    {
      "username": "alice",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Liddell",
      "email": "alice@example.com",
      "groups": [
        "/mcp-admins",
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "alice-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "carol",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Danvers",
      "email": "carol@example.com",
      "groups": [
        "/mcp-support",
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "carol-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "bob",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "email": "bob@example.com",
      "groups": [
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "bob-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "dave",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Lister",
      "email": "dave@example.com",
      "groups": [
        "/staff"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "dave-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "erin",
      "realmRoles": ["offline_access"],
      "enabled": true,
      "emailVerified": true,
      "firstName": "Erin",
      "lastName": "Brockovich",
      "email": "erin@example.com",
      "groups": [],
      "credentials": [
        {
          "type": "password",
          "value": "erin-demo",
          "temporary": false
        }
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "keycloak-mcp-server",
        "roles": [
          "realm-admin"
        ]
      }
    ]
  }
}