# User login: the MCP endpoint requires an OAuth login (LM Studio / Claude open the browser, the user logs in at
# Keycloak as alice or carol and consents to the server acting for them), and every Admin API call is made with a
# delegated token Keycloak issues for that user and the server's client keycloak-mcp together (token exchange
# delegation, preview in Keycloak 26.8): sub = the user, act = keycloak-mcp. The user's own token never reaches the
# Admin API (the MCP specification forbids passing it through), and the server's client holds no admin role at all.
# Keycloak enforces the user's realm-management roles:
#   alice  /mcp-admins  -> realm-admin                 (everything works)
#   carol  /mcp-support -> view-users, view-events     (reads work, writes come back as forbidden)
#   bob    no realm-management roles                   (every tool call is forbidden)
# LM Studio: copy mcp-oauth.json (pre-registered public client mcp-consumer, PKCE). Keycloak must be up before
# the server starts: the OIDC tenant reads the realm's discovery document at startup. What Keycloak needs for this
# (consent on mcp-consumer, the client keycloak-mcp, the delegate permission): ../delegated-auth/README.md.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8080
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=exchange
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=keycloak-mcp
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=keycloak-mcp-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
# the server's client may not read the server info, so the version is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
# Bearer tokens of realm demo are verified; issuer = KC_MCP_SYSTEMS_DEFAULT_URL/realms/KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM.
KC_MCP_MCP_OAUTH_ENABLED=true
# Only tokens issued for the MCP server: the audience mapper on mcp-consumer adds aud=keycloak-mcp.
KC_MCP_MCP_OAUTH_AUDIENCE=keycloak-mcp
# What the protected resource metadata tells MCP clients to ask for (RFC 9728 scopes_supported): without the
# delegation scope the user is not asked to consent and every tool answers delegation_failed.
KC_MCP_MCP_OAUTH_RESOURCE_METADATA_SCOPES=openid,delegation:client:keycloak-mcp
# Realm admins know what they do: the model is told to pass confirm: true right away instead of asking them first
# (guidance only; without elicitation or CIBA the flag is still what confirms, see kc-mcp.model-confirmation).
KC_MCP_MODEL_CONFIRMATION_TRUSTED_ROLES=realm-management.realm-admin
# When the server runs in Docker and reaches Keycloak as http://keycloak:8080, the token issuer still is the
# public URL, and MCP clients must be sent there for the login: uncomment and keep KC_MCP_SYSTEMS_DEFAULT_URL internal.
# KC_MCP_MCP_OAUTH_TOKEN_ISSUER=http://localhost:8080/realms/demo
# KC_MCP_MCP_OAUTH_RESOURCE_METADATA_AUTHORIZATION_SERVER=http://localhost:8080/realms/demo
# The management UI, to look around while the demo runs: http://localhost:8081/ui/ (alice / alice-demo; carol /
# carol-demo as a read-only viewer), with the systems, the realm and the audit trail of the tool calls. It needs the
# database storage, here an H2 file under data/ (git-ignored), and HTTPS, which dev mode lifts (its session cookie
# drops Secure; for one person's machine only; ../management-ui has the HTTPS setup). Dynamic systems stay off, so
# the systems configured here stay as they are. docs/management-ui.md
KC_MCP_UI_ENABLED=true
KC_MCP_DEV_MODE=true
KC_MCP_UI_OPERATOR_ROLE=realm-management.realm-admin
KC_MCP_UI_VIEWER_ROLE=realm-management.view-users
KC_MCP_DYNAMIC_SYSTEMS=false
QUARKUS_DATASOURCE_JDBC_URL=jdbc:h2:file:./data/kc-mcp-run-modes
KC_MCP_STORAGE_SECRET_KEY=demo-storage-key-change-me
