# Troubleshooting with read-only access: the server reads, and nothing else, twice over.
#   - Keycloak: the service account mcp-support holds only view-* roles of realm shop, so Keycloak refuses any change
#   - the server: KC_MCP_TOOLS_READ_ONLY hides and refuses every write and destructive tool, and stops any request to the
#     Admin API that is not a GET, whatever a tool declares
# Nobody logs in at the MCP endpoint (security profile local): a support engineer's own machine. For a server other
# people reach, combine KC_MCP_TOOLS_READ_ONLY with a user login as in examples/run-modes/env/shared.env.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8104
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=shop
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=mcp-support
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=mcp-support-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=shop
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=shop
KC_MCP_TOOLS_READ_ONLY=true
KC_MCP_TOOLS_EXPOSURE=hybrid
QUARKUS_HTTP_PORT=8105
# view-* roles do not show the server version, so it is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
# The management UI, to look around while the demo runs: http://localhost:8105/ui/ (sam / sam-demo, a support
# engineer of the realm with view-users and view-events), with the system, the realm and the audit trail of the tool
# calls the model made. sam is a viewer (KC_MCP_UI_VIEWER_ROLE): read-only, like the server. The UI needs the
# database storage, here an H2 file under data/ (git-ignored), and HTTPS, which dev mode lifts (its session
# cookie drops Secure; for one person's machine only). Dynamic systems stay off, so the one system here remains the
# default. docs/management-ui.md
KC_MCP_UI_ENABLED=true
KC_MCP_DEV_MODE=true
KC_MCP_UI_VIEWER_ROLE=realm-management.view-events
KC_MCP_DYNAMIC_SYSTEMS=false
QUARKUS_DATASOURCE_JDBC_URL=jdbc:h2:file:./data/kc-mcp-support
KC_MCP_STORAGE_SECRET_KEY=demo-storage-key-change-me
