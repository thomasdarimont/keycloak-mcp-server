# Troubleshooting with read-only access: the server reads, and nothing else, twice over.
#   - Keycloak: the service account mcp-support holds only view-* roles of realm shop, so Keycloak refuses any change
#   - the server: KC_MCP_READ_ONLY hides and refuses every write and destructive tool, and stops any request to the
#     Admin API that is not a GET, whatever a tool declares
# Nobody logs in at the MCP endpoint (security profile local): a support engineer's own machine. For a server other
# people reach, combine KC_MCP_READ_ONLY with a user login as in examples/run-modes/env/shared.env.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8104
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=shop
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=mcp-support
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=mcp-support-secret
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=shop
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=shop
KC_MCP_READ_ONLY=true
KC_MCP_TOOL_EXPOSURE=hybrid
QUARKUS_HTTP_PORT=8105
# view-* roles do not show the server version, so it is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
