# Step-up with a passkey, device login: the MCP endpoint requires an OAuth login, and every Admin API call is made
# with a delegated token Keycloak issues for that user and the server's client keycloak-mcp together (token exchange
# delegation, preview in Keycloak 26.8): sub = the user, act = keycloak-mcp. The user consents to that at login; their
# own token never reaches the Admin API. Destructive tools run only for a caller whose login is a passkey login of
# the last minute. An MCP client cannot ask for that, so the server does: the refused call starts a device
# authorization at Keycloak as the client mcp-step-up and answers with Keycloak's own link; the user signs in there
# with their passkey, and the next call runs. The user's browser only has to reach Keycloak, not this server.
#   alice  realm-admin  (alice-demo)     carol  view-users (carol-demo)
# Keycloak must be up before the server starts: the OIDC tenant reads the realm's discovery document at startup.
# What Keycloak needs for the delegation (consent on mcp-consumer, the client keycloak-mcp, the delegate permission):
# ../delegated-auth/README.md.
KC_MCP_SYSTEMS_DEFAULT_URL=http://localhost:8108
KC_MCP_SYSTEMS_DEFAULT_AUTH_REALM=demo
KC_MCP_DELEGATION=exchange
KC_MCP_SYSTEMS_DEFAULT_GRANT_TYPE=client_credentials
KC_MCP_SYSTEMS_DEFAULT_CLIENT_ID=keycloak-mcp
KC_MCP_SYSTEMS_DEFAULT_CLIENT_SECRET=keycloak-mcp-secret
# the server's client may not read the server info, so the version is stated (capability checks)
KC_MCP_SYSTEMS_DEFAULT_VERSION=26.8.2
KC_MCP_SYSTEMS_DEFAULT_DEFAULT_REALM=demo
KC_MCP_SYSTEMS_DEFAULT_ALLOWED_REALMS=demo
KC_MCP_TOOL_EXPOSURE=hybrid
QUARKUS_HTTP_PORT=8109
QUARKUS_OIDC_TENANT_ENABLED=true
# Only tokens issued for the MCP server: the audience mapper on mcp-consumer adds aud=keycloak-mcp.
QUARKUS_OIDC_TOKEN_AUDIENCE=keycloak-mcp
# What the protected resource metadata tells MCP clients to ask for: without the delegation scope the user is not
# asked to consent and every tool answers delegation_failed.
QUARKUS_OIDC_RESOURCE_METADATA_SCOPES=openid,delegation:client:keycloak-mcp
# the step-up check (kc-mcp.spi.access-check.step-up.*): the acr the realm maps to its passkey level, at most a minute
# old, for destructive tools (the default of levels)
KC_MCP_SPI_ACCESS_CHECK_STEP_UP_DEFAULT=on
KC_MCP_SPI_ACCESS_CHECK_STEP_UP_ACR=passkey
# one minute, so that the demo shows the step-up running out; the realm asks for the passkey again after the same
# time (loa-max-age of its passkey level). A real setup would rather take 5m in both places.
KC_MCP_SPI_ACCESS_CHECK_STEP_UP_MAX_AGE=1m
# the login the server runs for callers that fall short; the client's secret is a server setting only
KC_MCP_SPI_ACCESS_CHECK_STEP_UP_LOGIN=device
KC_MCP_SPI_ACCESS_CHECK_STEP_UP_LOGIN_CLIENT_ID=mcp-step-up
KC_MCP_SPI_ACCESS_CHECK_STEP_UP_LOGIN_CLIENT_SECRET=mcp-step-up-secret
# KC_MCP_SPI_ACCESS_CHECK_STEP_UP_LOGIN_TIMEOUT=5m     # how long a link works
# KC_MCP_SPI_ACCESS_CHECK_STEP_UP_LEVELS=write,destructive
# KC_MCP_SPI_ACCESS_CHECK_STEP_UP_TOOLS=user_delete,client_secret_get
